# ─────────────────────────────────────────────────────────────────────────────
# ReachInbox Frontend Environment Template
# Copy this file to .env in the frontend directory. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Google Identity Services (Client ID for Google Sign-In)
# Obtain from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
